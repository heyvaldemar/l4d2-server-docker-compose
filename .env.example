# Copy to .env beside the compose file, then edit. .env is gitignored.

# ---------------------------------------------------------------- required
# Anyone with this can run any command on the server. Generate one:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 32
L4D2_SERVER_RCON_PASSWORD=

# ---------------------------------------------------------------- the server
# The name players see is set in server.cfg.
L4D2_SERVER_START_MAP=c8m1_apartment
# coop, realism, versus, survival, scavenge - comma-separated to allow several.
L4D2_SERVER_GAME_TYPES=coop

# ---------------------------------------------------------------- networking
# Game, query and rcon port. Published on the host under the same number on
# purpose: Steam's list records the port the server BINDS, so publishing a
# different one outside hands players an address where a different server
# answers.
L4D2_SERVER_PORT=27015

# ---------------------------------------------------------------- overridable defaults
# Everything below has a working default in the compose file; set it here only
# to change it, and the change survives every git pull.
#
# L4D2_SERVER_IMAGE_VERSION=master@sha256:...
# L4D2_SERVER_IMAGE_TAG=jackzmc/srcds-l4d2:master
#
# 3g is measured: a four-player co-op server peaked at 432 MB. The ceiling
# exists so a leak here cannot get some other container killed instead.
# L4D2_SERVER_MEMORY_LIMIT=3g
# L4D2_SERVER_CPU_LIMIT=2.0
# L4D2_SERVER_MEMORY_RESERVATION=512m
# L4D2_SERVER_CPU_RESERVATION=0.5
#
# L4D2_SERVER_START_PERIOD=120s
# L4D2_SERVER_STOP_GRACE_PERIOD=30s
# L4D2_SERVER_LOG_MAX_SIZE=10m
# L4D2_SERVER_LOG_MAX_FILE=3
